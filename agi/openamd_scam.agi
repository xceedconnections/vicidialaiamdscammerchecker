#!/usr/bin/env perl
#
# OpenAMD SCAM arm — MixMonitor agent leg + upload to AIAMD.
# MUST NOT block HUMAN -> agent. Always exit 0 immediately after arming.
#
# Bug fixed: background "sleep N; mixmonitor stop" was staying in the AGI
# process tree, so Asterisk kept the AGI open for N seconds, returned 4,
# and never ran agi-VDAD_ALL_outbound.agi.
#
use strict;
use warnings;
use Asterisk::AGI;
use LWP::UserAgent;
use HTTP::Request::Common;
use POSIX qw(setsid);

my $AGI = new Asterisk::AGI;
my %input = $AGI->ReadParse();

$AGI->set_variable('OPENAMD_SCAM_ARMED', '0');

sub v {
    my $x = $AGI->get_variable($_[0]) // '';
    $x =~ s/^\s+|\s+$//g;
    return $x;
}

sub load_conf {
    my ($url, $key, $ssl_verify) = @_;
    $url = $ENV{'OPENAMD_URL'} // $url;
    $key = $ENV{'OPENAMD_API_KEY'} // $key;
    $ssl_verify = $ENV{'OPENAMD_SSL_VERIFY'} // $ssl_verify;
    if (-r '/etc/asterisk/openamd.conf') {
        if (open my $fh, '<', '/etc/asterisk/openamd.conf') {
            while (my $line = <$fh>) {
                chomp $line;
                next if $line =~ /^\s*#/ || $line =~ /^\s*$/;
                $key = $1 if $line =~ /^OPENAMD_API_KEY=(.+)$/;
                $url = $1 if $line =~ /^OPENAMD_URL=(.+)$/;
                $ssl_verify = $1 if $line =~ /^OPENAMD_SSL_VERIFY=(.+)$/;
            }
            close $fh;
        }
    }
    $ssl_verify = 'auto' if !defined $ssl_verify || $ssl_verify eq '';
    if (lc($ssl_verify) eq 'auto') {
        if ($url =~ m{^https?://(\d{1,3}(?:\.\d{1,3}){3})(:\d+)?(/|$)}i) {
            $ssl_verify = 0;
        } else {
            $ssl_verify = 1;
        }
    }
    $ssl_verify = ($ssl_verify =~ /^(1|true|yes|on)$/i) ? 1 : 0;
    return ($url, $key, $ssl_verify);
}

sub make_ua {
    my ($timeout, $ssl_verify) = @_;
    my $ua = LWP::UserAgent->new(
        timeout => $timeout // 1,
        max_redirect => 1,
        protocols_allowed => ['http', 'https'],
    );
    if (!$ssl_verify) {
        $ua->ssl_opts(verify_hostname => 0, SSL_verify_mode => 0);
    }
    return $ua;
}

sub scam_urls {
    my ($analyze_url) = @_;
    my $base = $analyze_url // '';
    $base =~ s#/api/v1/analyze\s*$##i;
    $base =~ s#/+$##;
    return (
        "$base/api/v1/scam/config",
        "$base/api/v1/scam/recording",
        "$base/api/v1/scam/arm",
    );
}

sub shell_quote {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

# Fully detach from AGI so Asterisk does not wait on sleep children.
sub spawn_detached {
    my ($bash_cmd) = @_;
    my $pid = fork();
    return unless defined $pid;
    if ($pid == 0) {
        fork() && exit 0;    # intermediate exits; grandchild continues
        setsid();
        open STDIN,  '</dev/null';
        open STDOUT, '>/dev/null';
        open STDERR, '>/dev/null';
        exec('/bin/bash', '-c', $bash_cmd);
        exit 0;
    }
    waitpid($pid, 0);        # only wait for intermediate (instant)
}

eval {
    my ($url, $key, $ssl_verify) = load_conf('http://127.0.0.1:2130/api/v1/analyze', '', 'auto');
    my ($cfg_url, $upload_url, $arm_url) = scam_urls($url);

    unless ($key) {
        $AGI->verbose('OpenAMD SCAM: no API key — skip (agent continues)', 1);
        exit 0;
    }

    my $ua = make_ua(1, $ssl_verify);
    my $req = HTTP::Request->new(GET => $cfg_url);
    $req->header('X-API-Key' => $key);
    my $res = eval { $ua->request($req) };
    if (!$res || !$res->is_success) {
        my $err = $res ? $res->status_line : ($@ || 'no response');
        $AGI->verbose("OpenAMD SCAM: config failed ($err) — skip (agent continues)", 1);
        exit 0;
    }
    my $body = $res->decoded_content // '';
    unless ($body =~ /"scam_protection_enabled"\s*:\s*true/i) {
        $AGI->verbose('OpenAMD SCAM: OFF — skip (agent continues)', 1);
        exit 0;
    }

    my $secs = 120;
    if ($body =~ /"scam_record_seconds"\s*:\s*(\d+)/i) {
        $secs = int($1);
    } elsif ($body =~ /"record_max_seconds"\s*:\s*(\d+)/i) {
        $secs = int($1);
    }
    $secs = 30  if $secs < 30;
    $secs = 600 if $secs > 600;

    my $uid = v('UNIQUEID');
    $uid =~ s/[^\w.\-]+/_/g;
    $uid = time() . '-scam' if $uid eq '';
    my $wav  = "/tmp/openamd-scam-${uid}.wav";
    my $meta = "/tmp/openamd-scam-${uid}.meta";

    my $caller = v('OPENAMD_CALLER');
    $caller = v('CALLERID(num)') if $caller eq '';
    my $called = v('OPENAMD_CALLED');
    my $camp = v('OPENAMD_CAMPAIGN');
    $camp = v('CAMPCUST') if $camp eq '';
    my $agent = v('agent_user');
    $agent = v('AGENT') if $agent eq '';

    if (open my $mf, '>', $meta) {
        print $mf "callid=$uid\n";
        print $mf "caller=$caller\n";
        print $mf "called=$called\n";
        print $mf "campaign=$camp\n";
        print $mf "agent=$agent\n";
        print $mf "upload_url=$upload_url\n";
        print $mf "record_seconds=$secs\n";
        close $mf;
    }

    my $finish = '/var/lib/asterisk/agi-bin/openamd_scam_upload.sh';
    $finish = '/usr/share/asterisk/agi-bin/openamd_scam_upload.sh' unless -x $finish;
    unless (-x $finish) {
        $AGI->verbose('OpenAMD SCAM: upload script missing — skip (agent continues)', 1);
        exit 0;
    }

    # Record channel audio (not bridged-only) so pre-agent + agent leg both land.
    # Use ^ as MixMonitor command arg separator (no spaces — AGI-safe)
    my $mm_ok = eval { $AGI->exec('MixMonitor', "${wav},,${finish}^${wav}^${meta}"); 1 };
    if (!$mm_ok) {
        $AGI->verbose('OpenAMD SCAM: MixMonitor failed — skip (agent continues)', 1);
        exit 0;
    }

    my $chan = $input{'channel'} // '';
    $chan =~ s/['"]//g;
    if ($chan ne '') {
        # MUST be fully detached or AGI blocks for $secs and agent never connects
        spawn_detached(
            "sleep $secs; /usr/sbin/asterisk -rx 'mixmonitor stop $chan' >/dev/null 2>&1"
        );
    }

    # Notify portal immediately (detached) so SCAMMERS shows PENDING before upload finishes
    my $curl_k = $ssl_verify ? '' : '-k ';
    my $arm_cmd =
        "curl -fsS ${curl_k}--max-time 3 "
        . "-H " . shell_quote("X-API-Key: $key") . " "
        . "-F " . shell_quote("callid=$uid") . " "
        . "-F " . shell_quote("campaign=$camp") . " "
        . "-F " . shell_quote("caller=$caller") . " "
        . "-F " . shell_quote("called=$called") . " "
        . "-F " . shell_quote("agent=$agent") . " "
        . shell_quote($arm_url)
        . " >/dev/null 2>&1";
    spawn_detached($arm_cmd);

    $AGI->set_variable('OPENAMD_SCAM_ARMED', '1');
    $AGI->verbose(
        "OpenAMD SCAM: armed $wav max ${secs}s — continuing to agent NOW",
        1
    );
};
if ($@) {
    $AGI->verbose("OpenAMD SCAM: exception $@ — agent continues", 1);
}
exit 0;
