#!/usr/bin/env perl
#
# OpenAMD VICIdial AGI
#
# Local-presence truth at extension 8399 (confirmed by debug dump):
#   CALLERID(num) = outbound Caller ID (local presence)  -> portal "Caller ID"
#   lead/called   = NOT on the SIP channel               -> must come from
#                   AstDB (stored at dial time) or reverse dialplan lookup
#
# Failover:
#   OPENAMD_STATUS=UNAVAILABLE / ERROR  -> dialplan must Goto stock AMD 8369
#   (never treat as HUMAN — that bypasses AIAMD with no SQL/recording)
#
# Modes:
#   AGI(openamd.agi,ping)  — fast health check only (no WAV required)
#   AGI(openamd.agi,ID,...) — analyze recorded /tmp/openamd-ID.wav
#
use strict;
use warnings;
use Asterisk::AGI;
use LWP::UserAgent;
use HTTP::Request::Common;

my $AGI = new Asterisk::AGI;
my %input = $AGI->ReadParse();

my $callid   = $ARGV[0] // $input{'uniqueid'} // time();
my $campaign = $ARGV[1] // '';
my $arg_cid  = $ARGV[2] // '';
my $arg_lead = $ARGV[3] // '';

sub v {
    my $x = $AGI->get_variable($_[0]) // '';
    $x =~ s/^\s+|\s+$//g;
    return $x;
}
sub phone {
    my ($n) = @_;
    return 0 if !defined $n || $n eq '';
    return 0 if $n =~ /^(s|h|8399|8369|8368|unknown|anonymous)$/i;
    return $n =~ /^\d{7,15}$/;
}

sub load_conf {
    my ($url, $key, $ssl_verify) = @_;
    $url = $ENV{'OPENAMD_URL'} // $url;
    $key = $ENV{'OPENAMD_API_KEY'} // $key;
    $ssl_verify = $ENV{'OPENAMD_SSL_VERIFY'} // $ssl_verify;
    if (-r '/etc/asterisk/openamd.conf') {
        if (open my $fh, '<', '/etc/asterisk/openamd.conf') {
            while (my $line = <$fh>) {
                chomp $line;
                next if $line =~ /^\s*#/ || $line =~ /^\s*$/;
                $key = $1 if $line =~ /^OPENAMD_API_KEY=(.+)$/;
                $url = $1 if $line =~ /^OPENAMD_URL=(.+)$/;
                $ssl_verify = $1 if $line =~ /^OPENAMD_SSL_VERIFY=(.+)$/;
            }
            close $fh;
        }
    }
    $ssl_verify = 'auto' if !defined $ssl_verify || $ssl_verify eq '';
    # auto: skip hostname verify for bare-IP hosts (HTTPS cert rarely matches IP)
    if (lc($ssl_verify) eq 'auto') {
        if ($url =~ m{^https?://(\d{1,3}(?:\.\d{1,3}){3})(:\d+)?(/|$)}i) {
            $ssl_verify = 0;
        } else {
            $ssl_verify = 1;
        }
    }
    $ssl_verify = ($ssl_verify =~ /^(1|true|yes|on)$/i) ? 1 : 0;
    return ($url, $key, $ssl_verify);
}

sub make_ua {
    my ($timeout, $ssl_verify) = @_;
    my $ua = LWP::UserAgent->new(
        timeout       => $timeout // 5,
        max_redirect  => 3,
        protocols_allowed => ['http', 'https'],
    );
    # Allow HTTPS to IP / self-signed / domain-mismatch certs when verify is off
    if (!$ssl_verify) {
        $ua->ssl_opts(
            verify_hostname => 0,
            SSL_verify_mode => 0,
        );
    }
    return $ua;
}

sub health_url_from {
    my ($analyze_url) = @_;
    my $h = $analyze_url // '';
    $h =~ s#/api/v1/analyze\s*$#/api/health#i;
    $h =~ s#/api/v1/analyze/+$##i;
    if ($h eq $analyze_url || $h !~ m#/api/health#) {
        if ($analyze_url =~ m{^(https?://[^/]+)}i) {
            $h = "$1/api/health";
        }
    }
    return $h;
}

sub admit_url_from {
    my ($analyze_url) = @_;
    my $a = $analyze_url // '';
    $a =~ s#/api/v1/analyze\s*$#/api/v1/admit#i;
    $a =~ s#/api/v1/analyze/+$##i;
    if ($a eq $analyze_url || $a !~ m#/api/v1/admit#) {
        if ($analyze_url =~ m{^(https?://[^/]+)}i) {
            $a = "$1/api/v1/admit";
        }
    }
    return $a;
}

sub set_unavailable {
    my ($why) = @_;
    $AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->set_variable('OPENAMD_ADMITTED', '0');
    $AGI->verbose("OpenAMD UNAVAILABLE: $why (dialplan should use stock AMD 8369)", 1);
}

# No usable audio = fall back to stock AMD 8369 (same as offline).
# Previously we hung up as MACHINE — that starved agents when Record missed
# a live hello (Playback/Wait delay) or captured only silence.
sub set_machine {
    my ($why) = @_;
    $AGI->set_variable('OPENAMD_STATUS', 'MACHINE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0.99');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->verbose("OpenAMD MACHINE: $why", 1);
}

sub set_fallback_8369 {
    my ($why) = @_;
    $AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->set_variable('OPENAMD_ADMITTED', '0');
    $AGI->verbose("OpenAMD FALLBACK 8369: $why", 1);
}

my ($url, $key, $ssl_verify) = load_conf('http://127.0.0.1/api/v1/analyze', '', 'auto');
my $health = health_url_from($url);
my $admit  = admit_url_from($url);

# ------------------------------------------------------------------
# Ping / admit mode (before Record) — fail fast to 8369
# Checks online + per-server CPS limit. Over CPS = same as offline.
# ------------------------------------------------------------------
if ($callid eq 'ping' || $callid eq '--ping--') {
    $AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->set_variable('OPENAMD_ADMITTED', '0');

    unless ($key) {
        set_unavailable('API key missing');
        exit 0;
    }
    unless ($admit) {
        set_unavailable('admit URL missing');
        exit 0;
    }

    my $ua = make_ua(2, $ssl_verify);
    my $req = HTTP::Request->new(GET => $admit);
    $req->header('X-API-Key' => $key);
    my $res = eval { $ua->request($req) };
    if (!$res) {
        set_unavailable('admit request failed: ' . ($@ || 'no response'));
        exit 0;
    }
    if ($res->code == 429) {
        set_unavailable('CPS limit exceeded — using stock AMD 8369');
        exit 0;
    }
    if (!$res->is_success) {
        # Fall back to public health if admit missing on older servers
        if ($res->code == 404 && $health) {
            my $hr = eval { $ua->get($health) };
            if ($hr && $hr->is_success) {
                $AGI->set_variable('OPENAMD_STATUS', 'OK');
                $AGI->set_variable('OPENAMD_ADMITTED', '0');
                $AGI->verbose("OpenAMD health OK (legacy, no /admit) ($health)", 1);
                exit 0;
            }
        }
        set_unavailable('admit/health failed: ' . $res->status_line);
        exit 0;
    }
    $AGI->set_variable('OPENAMD_STATUS', 'OK');
    $AGI->set_variable('OPENAMD_ADMITTED', '1');
    $AGI->verbose("OpenAMD admit OK ($admit)", 1);
    exit 0;
}

my $lid = v('CHANNEL(linkedid)');
$lid = v('UNIQUEID') if $lid eq '';

my $channel_cid  = v('CALLERID(num)');
my $phone_number = v('phone_number');
my $campcust     = v('CAMPCUST');
my $cid_name     = v('CALLERID(name)');

# AstDB written at dial time (safe inject after Set(CALLERID), never touches Dial)
my $db_outcid = v("DB(openamd/$lid/outcid)");
my $db_lead   = v("DB(openamd/$lid/lead)");
my $db_camp   = v("DB(openamd/$lid/campaign)");

# --- light debug (keep until mapping confirmed) ---
{
    my $line = join(' | ',
        "lid=$lid",
        "CALLERID(num)=$channel_cid",
        "CALLERID(name)=$cid_name",
        "phone_number=$phone_number",
        "DB.outcid=$db_outcid",
        "DB.lead=$db_lead",
        "ARGV.cid=$arg_cid",
        "ARGV.lead=$arg_lead",
    );
    $AGI->verbose("OpenAMD DEBUG $line", 1);
    if (open my $dfh, '>>', '/tmp/openamd_debug.log') {
        print $dfh "[" . (scalar localtime) . "] callid=$callid $line\n";
        close $dfh;
    }
}

# ------------------------------------------------------------------
# Caller ID = local-presence outbound CID
# At 8399 on SIP/trunk, CALLERID(num) IS the Caller ID (not the lead).
# ------------------------------------------------------------------
my $outcid = '';
for my $c ($db_outcid, $arg_cid, $channel_cid) {
    if (phone($c)) {
        $outcid = $c;
        last;
    }
}

# ------------------------------------------------------------------
# Called Number = lead being dialed
# Prefer AstDB / explicit args / phone_number — NEVER default to CALLERID.
# ------------------------------------------------------------------
my $lead = '';
for my $c ($db_lead, $arg_lead, $phone_number) {
    if (phone($c) && (!$outcid || $c ne $outcid)) {
        $lead = $c;
        last;
    }
}

# Reverse dialplan lookup:
#   exten => 9LEAD,...,Set(CALLERID(num)=OUTCID)
# Find the line that sets this CID and strip the leading 8/9 prefix.
if (!$lead && phone($outcid)) {
    my $cid_re = quotemeta($outcid);
    my $grep = qq{grep -h -E 'exten[[:space:]]*=>[[:space:]]*[89][0-9]{7,15}.*Set\\(CALLERID\\(num\\)=$cid_re\\)' }
             . qq{/etc/asterisk/extensions.conf /etc/asterisk/extensions-vicidial.conf }
             . qq{/etc/asterisk/extensions-custom.conf 2>/dev/null};
    my $hit = `$grep`;
    if ($hit =~ /exten\s*=>\s*[89](\d{7,15})\s*,/ ) {
        my $candidate = $1;
        if (phone($candidate) && $candidate ne $outcid) {
            $lead = $candidate;
            $AGI->verbose("OpenAMD reverse-dialplan lead=$lead for cid=$outcid", 1);
        }
    }
}

my $camp = $campaign || $db_camp || $campcust || '';

# If somehow identical, keep Caller ID and blank Called (do not swap).
if (phone($outcid) && phone($lead) && $outcid eq $lead) {
    $lead = '';
}

$AGI->verbose(
    "OpenAMD MAP lid=$lid CALLER(outcid)=$outcid CALLED(lead)=$lead campaign=$camp",
    1
);

my $wav = "/tmp/openamd-${callid}.wav";
$AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
$AGI->set_variable('OPENAMD_CONFIDENCE', '0');
$AGI->set_variable('OPENAMD_MS', '0');

unless ($key) {
    set_unavailable('API key missing');
    exit 0;
}
unless (-f $wav) {
    # Missed Record (timing) — use stock 8369 instead of hanging up everyone
    set_fallback_8369("wav missing $wav");
    exit 0;
}
my $wav_bytes = -s $wav;
$wav_bytes = 0 unless defined $wav_bytes;
if ($wav_bytes < 200) {
    # Empty capture — stock AMD is safer than auto-hangup (agents were starving)
    set_fallback_8369("blank wav ${wav_bytes} bytes");
    unlink $wav if -f $wav;
    exit 0;
}

# Quick re-check before spending analyze time (server may have gone down mid-call)
{
    my $ua_h = make_ua(2, $ssl_verify);
    my $hr = eval { $ua_h->get($health) };
    if (!$hr || !$hr->is_success) {
        my $err = $hr ? $hr->status_line : ($@ || 'no response');
        if ($wav_bytes < 200) {
            set_fallback_8369("blank wav + health failed: $err");
            unlink $wav if -f $wav;
            exit 0;
        }
        set_unavailable("pre-analyze health failed: $err");
        unlink $wav if -f $wav;
        exit 0;
    }
}

my $ua = make_ua(12, $ssl_verify);
my $admitted = v('OPENAMD_ADMITTED');
my $res = eval {
    $ua->request(
        POST $url,
        Content_Type => 'form-data',
        Content => [
            callid   => $callid,
            campaign => $camp,
            caller   => $outcid,
            called   => $lead,
            ani      => $lead,
            audio    => [$wav, "openamd-${callid}.wav", 'Content-Type' => 'audio/wav'],
        ],
        'X-API-Key' => $key,
        # Only skip a second CPS slot when ping already called /admit successfully
        'X-OpenAMD-Admitted' => ($admitted eq '1' ? '1' : '0'),
    );
};

if (!$res) {
    if ($wav_bytes < 200) {
        set_fallback_8369('blank wav + analyze exception: ' . ($@ || 'unknown'));
    } else {
        set_unavailable('analyze request exception: ' . ($@ || 'unknown'));
    }
} elsif ($res->code == 429) {
    set_unavailable('CPS limit exceeded on analyze - using stock AMD 8369');
} elsif ($res->code == 400) {
    # Empty/bad audio — stock 8369, do not auto-hangup
    set_fallback_8369('HTTP 400 empty/blank audio');
} elsif ($res->is_success) {
    my $b = $res->decoded_content;
    my ($st) = $b =~ /"status"\s*:\s*"([^"]+)"/;
    my ($cf) = $b =~ /"confidence"\s*:\s*([0-9.]+)/;
    my ($ms) = $b =~ /"processing_ms"\s*:\s*([0-9]+)/;
    $st = $st // 'ERROR';
    if ($st eq 'HUMAN' || $st eq 'MACHINE') {
        $AGI->set_variable('OPENAMD_STATUS', $st);
        $AGI->set_variable('OPENAMD_CONFIDENCE', $cf // '0');
        $AGI->set_variable('OPENAMD_MS', $ms // '0');
        $AGI->verbose("OpenAMD OK $st caller=$outcid called=$lead", 1);
    } elsif ($st eq 'BLANK') {
        # Quiet / delayed answer — let stock 8369 keep listening (do not AA hangup)
        set_fallback_8369('AIAMD BLANK/silence');
    } elsif ($wav_bytes < 200) {
        set_fallback_8369("blank wav + unexpected status=$st");
    } else {
        set_unavailable("unexpected analyze status=$st");
    }
} else {
    if ($wav_bytes < 200) {
        set_fallback_8369('blank wav + HTTP ' . $res->status_line);
    } else {
        set_unavailable('HTTP ' . $res->status_line);
    }
}

# Cleanup AstDB keys for this linkedid
if ($lid ne '') {
    $AGI->set_variable("DB_DELETE(openamd/$lid/outcid)", '');
    $AGI->set_variable("DB_DELETE(openamd/$lid/lead)", '');
    $AGI->set_variable("DB_DELETE(openamd/$lid/campaign)", '');
}

unlink $wav if -f $wav;
exit 0;
