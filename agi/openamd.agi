#!/usr/bin/env perl
#
# OpenAMD VICIdial AGI
#
# Local-presence truth at extension 8399 (confirmed by debug dump):
#   CALLERID(num) = outbound Caller ID (local presence)  -> portal "Caller ID"
#   lead/called   = NOT on the SIP channel               -> must come from
#                   AstDB (stored at dial time) or reverse dialplan lookup
#
# Failover / second-opinion policy (8399 stock HUMAN|PERSON|NOTSURE path):
#   Stock MACHINE → dialplan hangup (never reaches this AGI for decide).
#   Stock HUMAN|PERSON|NOTSURE → AIAMD second opinion:
#     AIAMD HUMAN with a real checked recording → agent + scam
#     AIAMD MACHINE / FAX / IVR (portal maps FAX|IVR → MACHINE) → AA hangup
#     blank / silent / missing WAV OR AIAMD down / ping fail / CPS / 429 →
#       TRUST STOCK → HUMAN → agent (stock already cleared the live party)
#
# Modes:
#   AGI(openamd.agi,ping)  — fast health check only (no WAV required)
#   AGI(openamd.agi,ID,...) — analyze the largest of
#     /tmp/openamd-ID.wav | -in.wav | -out.wav (Monitor and/or Record).
#     Dialplan must Record a 4s clip when Monitor is empty before calling us.
#     Missing/blank capture on stock HUMAN|PERSON|NOTSURE → trust stock.
#     Clear MACHINE / FAX / IVR still hangs up.
#
use strict;
use warnings;
use Asterisk::AGI;
use LWP::UserAgent;
use HTTP::Request::Common;

my $AGI = new Asterisk::AGI;
my %input = $AGI->ReadParse();

my $callid   = $ARGV[0] // $input{'uniqueid'} // time();
my $campaign = $ARGV[1] // '';
my $arg_cid  = $ARGV[2] // '';
my $arg_lead = $ARGV[3] // '';

# Stock AMDSTATUS is set by dialplan AMD() before openamd-detect / this AGI.
# Read early so ping-fail and blank-WAV paths can trust stock when appropriate.
my $stock_amdstatus = '';
{
    my $x = $AGI->get_variable('AMDSTATUS') // '';
    $x =~ s/^\s+|\s+$//g;
    $stock_amdstatus = uc($x);
}

sub v {
    my $x = $AGI->get_variable($_[0]) // '';
    $x =~ s/^\s+|\s+$//g;
    return $x;
}
sub phone {
    my ($n) = @_;
    return 0 if !defined $n || $n eq '';
    return 0 if $n =~ /^(s|h|8399|8398|8389|8369|8368|unknown|anonymous)$/i;
    return $n =~ /^\d{7,15}$/;
}

# Stock already heard a live party — trust HUMAN when second opinion is blank/down.
sub stock_trust_human {
    return ($stock_amdstatus eq 'HUMAN'
         || $stock_amdstatus eq 'PERSON'
         || $stock_amdstatus eq 'NOTSURE') ? 1 : 0;
}

sub set_human_trust_stock {
    my ($why) = @_;
    $AGI->set_variable('OPENAMD_STATUS', 'HUMAN');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0.90');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->verbose("OpenAMD HUMAN (trust stock $stock_amdstatus): $why", 1);
}

sub load_conf {
    my ($url, $key, $ssl_verify) = @_;
    $url = $ENV{'OPENAMD_URL'} // $url;
    $key = $ENV{'OPENAMD_API_KEY'} // $key;
    $ssl_verify = $ENV{'OPENAMD_SSL_VERIFY'} // $ssl_verify;
    if (-r '/etc/asterisk/openamd.conf') {
        if (open my $fh, '<', '/etc/asterisk/openamd.conf') {
            while (my $line = <$fh>) {
                chomp $line;
                next if $line =~ /^\s*#/ || $line =~ /^\s*$/;
                $key = $1 if $line =~ /^OPENAMD_API_KEY=(.+)$/;
                $url = $1 if $line =~ /^OPENAMD_URL=(.+)$/;
                $ssl_verify = $1 if $line =~ /^OPENAMD_SSL_VERIFY=(.+)$/;
            }
            close $fh;
        }
    }
    $ssl_verify = 'auto' if !defined $ssl_verify || $ssl_verify eq '';
    # auto: skip hostname verify for bare-IP hosts (HTTPS cert rarely matches IP)
    if (lc($ssl_verify) eq 'auto') {
        if ($url =~ m{^https?://(\d{1,3}(?:\.\d{1,3}){3})(:\d+)?(/|$)}i) {
            $ssl_verify = 0;
        } else {
            $ssl_verify = 1;
        }
    }
    $ssl_verify = ($ssl_verify =~ /^(1|true|yes|on)$/i) ? 1 : 0;
    return ($url, $key, $ssl_verify);
}

sub make_ua {
    my ($timeout, $ssl_verify) = @_;
    my $ua = LWP::UserAgent->new(
        timeout       => $timeout // 5,
        max_redirect  => 3,
        protocols_allowed => ['http', 'https'],
    );
    # Allow HTTPS to IP / self-signed / domain-mismatch certs when verify is off
    if (!$ssl_verify) {
        $ua->ssl_opts(
            verify_hostname => 0,
            SSL_verify_mode => 0,
        );
    }
    return $ua;
}

sub health_url_from {
    my ($analyze_url) = @_;
    my $h = $analyze_url // '';
    $h =~ s#/api/v1/analyze\s*$#/api/health#i;
    $h =~ s#/api/v1/analyze/+$##i;
    if ($h eq $analyze_url || $h !~ m#/api/health#) {
        if ($analyze_url =~ m{^(https?://[^/]+)}i) {
            $h = "$1/api/health";
        }
    }
    return $h;
}

sub admit_url_from {
    my ($analyze_url) = @_;
    my $a = $analyze_url // '';
    $a =~ s#/api/v1/analyze\s*$#/api/v1/admit#i;
    $a =~ s#/api/v1/analyze/+$##i;
    if ($a eq $analyze_url || $a !~ m#/api/v1/admit#) {
        if ($analyze_url =~ m{^(https?://[^/]+)}i) {
            $a = "$1/api/v1/admit";
        }
    }
    return $a;
}

sub set_unavailable {
    my ($why, $kind) = @_;
    # Portal unreachable / CPS: trust stock when AMD already said live party.
    if (stock_trust_human()) {
        set_human_trust_stock("AIAMD unavailable → trust stock ($why)");
        $AGI->set_variable('OPENAMD_ADMITTED', '0');
        $AGI->set_variable('OPENAMD_PING', ($kind || 'DOWN'));
        return;
    }
    $AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->set_variable('OPENAMD_ADMITTED', '0');
    # CPS = over per-second limit (skip Record; dialplan FALLBACK hangup)
    # DOWN = portal unreachable
    $AGI->set_variable('OPENAMD_PING', ($kind || 'DOWN'));
    $AGI->verbose("OpenAMD UNAVAILABLE: $why", 1);
}

# Clear MACHINE (VM / FAX / IVR mapped to MACHINE by portal).
sub set_machine {
    my ($why) = @_;
    $AGI->set_variable('OPENAMD_STATUS', 'MACHINE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0.99');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->verbose("OpenAMD MACHINE: $why", 1);
}

# Blank / silent / missing recording on 8399 second-opinion path:
# trust stock HUMAN|PERSON|NOTSURE → agent; otherwise MACHINE → AA.
sub set_blank_or_trust_stock {
    my ($why) = @_;
    if (stock_trust_human()) {
        set_human_trust_stock("blank/silent → trust stock ($why)");
        return;
    }
    set_machine("no usable recording — not passed to agent ($why)");
}

my ($url, $key, $ssl_verify) = load_conf('http://127.0.0.1/api/v1/analyze', '', 'auto');
my $health = health_url_from($url);
my $admit  = admit_url_from($url);

# ------------------------------------------------------------------
# Ping / admit mode (before analyze) — fail fast
# Checks online + per-server CPS limit. Over CPS = same as offline.
# When stock HUMAN|PERSON|NOTSURE: fail → HUMAN (agent), not FALLBACK hangup.
# ------------------------------------------------------------------
if ($callid eq 'ping' || $callid eq '--ping--') {
    $AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
    $AGI->set_variable('OPENAMD_CONFIDENCE', '0');
    $AGI->set_variable('OPENAMD_MS', '0');
    $AGI->set_variable('OPENAMD_ADMITTED', '0');
    $AGI->set_variable('OPENAMD_PING', 'DOWN');

    unless ($key) {
        set_unavailable('API key missing', 'NOKEY');
        exit 0;
    }
    unless ($admit) {
        set_unavailable('admit URL missing', 'NOKEY');
        exit 0;
    }

    my $ua = make_ua(2, $ssl_verify);
    my $req = HTTP::Request->new(GET => $admit);
    $req->header('X-API-Key' => $key);
    my $res = eval { $ua->request($req) };
    if (!$res) {
        set_unavailable('admit request failed: ' . ($@ || 'no response'));
        exit 0;
    }
    if ($res->code == 429) {
        set_unavailable('CPS limit exceeded', 'CPS');
        exit 0;
    }
    if ($res->code == 401 || $res->code == 403) {
        set_unavailable('rejected: ' . $res->status_line, 'AUTH');
        exit 0;
    }
    if (!$res->is_success) {
        # Fall back to public health if admit missing on older servers
        if ($res->code == 404 && $health) {
            my $hr = eval { $ua->get($health) };
            if ($hr && $hr->is_success) {
                $AGI->set_variable('OPENAMD_STATUS', 'OK');
                $AGI->set_variable('OPENAMD_ADMITTED', '0');
                $AGI->set_variable('OPENAMD_PING', 'OK');
                $AGI->verbose("OpenAMD health OK (legacy, no /admit) ($health)", 1);
                exit 0;
            }
        }
        set_unavailable('admit/health failed: ' . $res->status_line);
        exit 0;
    }
    $AGI->set_variable('OPENAMD_STATUS', 'OK');
    $AGI->set_variable('OPENAMD_ADMITTED', '1');
    $AGI->set_variable('OPENAMD_PING', 'OK');
    $AGI->verbose("OpenAMD admit OK ($admit)", 1);
    exit 0;
}

my $lid = v('CHANNEL(linkedid)');
$lid = v('UNIQUEID') if $lid eq '';

my $channel_cid  = v('CALLERID(num)');
my $phone_number = v('phone_number');
my $campcust     = v('CAMPCUST');
my $cid_name     = v('CALLERID(name)');

# AstDB written at dial time (safe inject after Set(CALLERID), never touches Dial)
my $db_outcid = v("DB(openamd/$lid/outcid)");
my $db_lead   = v("DB(openamd/$lid/lead)");
my $db_camp   = v("DB(openamd/$lid/campaign)");

# --- light debug (keep until mapping confirmed) ---
{
    my $line = join(' | ',
        "lid=$lid",
        "stock_amd=$stock_amdstatus",
        "CALLERID(num)=$channel_cid",
        "CALLERID(name)=$cid_name",
        "phone_number=$phone_number",
        "DB.outcid=$db_outcid",
        "DB.lead=$db_lead",
        "ARGV.cid=$arg_cid",
        "ARGV.lead=$arg_lead",
    );
    $AGI->verbose("OpenAMD DEBUG $line", 1);
    if (open my $dfh, '>>', '/tmp/openamd_debug.log') {
        print $dfh "[" . (scalar localtime) . "] callid=$callid $line\n";
        close $dfh;
    }
}

# ------------------------------------------------------------------
# Caller ID = local-presence outbound CID
# At 8399 on SIP/trunk, CALLERID(num) IS the Caller ID (not the lead).
# ------------------------------------------------------------------
my $outcid = '';
for my $c ($db_outcid, $arg_cid, $channel_cid) {
    if (phone($c)) {
        $outcid = $c;
        last;
    }
}

# ------------------------------------------------------------------
# Called Number = lead being dialed
# Prefer AstDB / explicit args / phone_number — NEVER default to CALLERID.
# ------------------------------------------------------------------
my $lead = '';
for my $c ($db_lead, $arg_lead, $phone_number) {
    if (phone($c) && (!$outcid || $c ne $outcid)) {
        $lead = $c;
        last;
    }
}

# Reverse dialplan lookup:
#   exten => 9LEAD,...,Set(CALLERID(num)=OUTCID)
# Find the line that sets this CID and strip the leading 8/9 prefix.
if (!$lead && phone($outcid)) {
    my $cid_re = quotemeta($outcid);
    my $grep = qq{grep -h -E 'exten[[:space:]]*=>[[:space:]]*[89][0-9]{7,15}.*Set\\(CALLERID\\(num\\)=$cid_re\\)' }
             . qq{/etc/asterisk/extensions.conf /etc/asterisk/extensions-vicidial.conf }
             . qq{/etc/asterisk/extensions-custom.conf 2>/dev/null};
    my $hit = `$grep`;
    if ($hit =~ /exten\s*=>\s*[89](\d{7,15})\s*,/ ) {
        my $candidate = $1;
        if (phone($candidate) && $candidate ne $outcid) {
            $lead = $candidate;
            $AGI->verbose("OpenAMD reverse-dialplan lead=$lead for cid=$outcid", 1);
        }
    }
}

my $camp = $campaign || $db_camp || $campcust || '';

# If somehow identical, keep Caller ID and blank Called (do not swap).
if (phone($outcid) && phone($lead) && $outcid eq $lead) {
    $lead = '';
}

$AGI->verbose(
    "OpenAMD MAP lid=$lid CALLER(outcid)=$outcid CALLED(lead)=$lead campaign=$camp stock=$stock_amdstatus",
    1
);

my $wav_base = "/tmp/openamd-${callid}";
my @wav_artifacts = (
    "${wav_base}.wav",
    "${wav_base}-in.wav",
    "${wav_base}-out.wav",
);
# Always remove merged and split Monitor artifacts, including timeout/error exits.
END {
    for my $path (@wav_artifacts) {
        unlink $path if defined $path && -f $path;
    }
}

# Prefer the largest Monitor/Record artifact. Order of preference when tied:
# merged .wav, then callee receive leg (-in), then -out.
my $wav = '';
my $best_bytes = -1;
for my $candidate (@wav_artifacts) {
    next unless -f $candidate;
    my $candidate_bytes = -s $candidate;
    $candidate_bytes = 0 unless defined $candidate_bytes;
    if ($candidate_bytes > $best_bytes) {
        $best_bytes = $candidate_bytes;
        $wav = $candidate;
    }
}
if ($wav ne '') {
    $AGI->verbose("OpenAMD pick wav=$wav bytes=$best_bytes", 1);
}

$AGI->set_variable('OPENAMD_STATUS', 'UNAVAILABLE');
$AGI->set_variable('OPENAMD_CONFIDENCE', '0');
$AGI->set_variable('OPENAMD_MS', '0');

unless ($key) {
    set_unavailable('API key missing');
    exit 0;
}
unless ($wav ne '' && -f $wav) {
    # No file — trust stock on 8399 HUMAN|PERSON|NOTSURE path.
    set_blank_or_trust_stock("Monitor wav missing: ${wav_base}{.wav,-in.wav,-out.wav}");
    exit 0;
}
my $wav_bytes = -s $wav;
$wav_bytes = 0 unless defined $wav_bytes;
if ($wav_bytes < 200) {
    # Header-only / 0-second capture. Still POST so the portal can log BLANK;
    # after response we trust stock (or AA if stock was not human).
    $AGI->verbose(
        "OpenAMD blank wav ${wav_bytes} bytes (stock=$stock_amdstatus) - post then trust/AA",
        1
    );
}

# Quick re-check before spending analyze time (server may have gone down mid-call)
{
    my $ua_h = make_ua(2, $ssl_verify);
    my $hr = eval { $ua_h->get($health) };
    if (!$hr || !$hr->is_success) {
        my $err = $hr ? $hr->status_line : ($@ || 'no response');
        if ($wav_bytes < 200) {
            set_blank_or_trust_stock("blank wav + health failed: $err");
        } else {
            set_unavailable("pre-analyze health failed: $err");
        }
        exit 0;
    }
}

# Prefer early-read stock; refresh in case dialplan updated AMDSTATUS
my $amdstatus = $stock_amdstatus || uc(v('AMDSTATUS'));
my $amdcause  = v('AMDCAUSE');

my $ua = make_ua(6, $ssl_verify);
my $admitted = v('OPENAMD_ADMITTED');
my $res = eval {
    $ua->request(
        POST $url,
        Content_Type => 'form-data',
        Content => [
            callid    => $callid,
            campaign  => $camp,
            caller    => $outcid,
            called    => $lead,
            ani       => $lead,
            amdstatus => $amdstatus,
            amdcause  => $amdcause,
            audio     => [$wav, "openamd-${callid}.wav", 'Content-Type' => 'audio/wav'],
        ],
        'X-API-Key' => $key,
        # Only skip a second CPS slot when ping already called /admit successfully
        'X-OpenAMD-Admitted' => ($admitted eq '1' ? '1' : '0'),
    );
};

if (!$res) {
    if ($wav_bytes < 200) {
        set_blank_or_trust_stock('blank wav + analyze exception: ' . ($@ || 'unknown'));
    } else {
        set_unavailable('analyze request exception: ' . ($@ || 'unknown'));
    }
} elsif ($res->code == 429) {
    if ($wav_bytes < 200) {
        set_blank_or_trust_stock('blank wav + CPS limit');
    } else {
        set_unavailable('CPS limit exceeded on analyze', 'CPS');
    }
} elsif ($res->code == 400) {
    set_blank_or_trust_stock('HTTP 400 empty/blank audio');
} elsif ($res->is_success) {
    my $b = $res->decoded_content;
    my ($st) = $b =~ /"status"\s*:\s*"([^"]+)"/;
    my ($cf) = $b =~ /"confidence"\s*:\s*([0-9.]+)/;
    my ($ms) = $b =~ /"processing_ms"\s*:\s*([0-9]+)/;
    $st = $st // 'ERROR';
    # Blank/silent → trust stock. Clear MACHINE (incl. FAX/IVR mapped) → AA.
    # HUMAN with a real clip → agent.
    if ($wav_bytes < 200 || $st eq 'BLANK' || $st eq 'SILENT') {
        set_blank_or_trust_stock("wav ${wav_bytes}B portal=$st");
    } elsif ($st eq 'HUMAN' || $st eq 'MACHINE') {
        $AGI->set_variable('OPENAMD_STATUS', $st);
        $AGI->set_variable('OPENAMD_CONFIDENCE', $cf // '0');
        $AGI->set_variable('OPENAMD_MS', $ms // '0');
        $AGI->verbose("OpenAMD OK $st caller=$outcid called=$lead", 1);
    } elsif ($st eq 'FAX' || $st eq 'IVR' || $st eq 'SIT') {
        set_machine("portal $st → AA");
    } else {
        if ($wav_bytes < 200) {
            set_blank_or_trust_stock("blank wav + unexpected status=$st");
        } else {
            set_unavailable("unexpected analyze status=$st");
        }
    }
} else {
    if ($wav_bytes < 200) {
        set_blank_or_trust_stock('blank wav + HTTP ' . $res->status_line);
    } else {
        set_unavailable('HTTP ' . $res->status_line);
    }
}

# Cleanup AstDB keys for this linkedid
if ($lid ne '') {
    $AGI->set_variable("DB_DELETE(openamd/$lid/outcid)", '');
    $AGI->set_variable("DB_DELETE(openamd/$lid/lead)", '');
    $AGI->set_variable("DB_DELETE(openamd/$lid/campaign)", '');
}

exit 0;
